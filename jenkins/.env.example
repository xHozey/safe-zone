# Copy this file to .env and replace the placeholders before starting Jenkins.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=replace-with-a-strong-password

# Required by the backend unit-test stage.
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb://replace-with-your-mongodb-host:27017/your-database
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
SERVER_SSL_KEY_STORE_PASSWORD=replace-me
SONAR_TOKEN=replace-with-a-sonarqube-user-token

# Optional email notifications.
CI_EMAIL_TO=
SMTP_FROM=jenkins@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
